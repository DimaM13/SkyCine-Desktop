#version 450

layout (local_size_x = 16, local_size_y = 16) in;

// Original native resolution frames (1080p, 4K, 720p, etc.)
layout (binding = 0) uniform sampler2D img0;
layout (binding = 1) uniform sampler2D img1;

// Optical flow vector map:
// RG = forward flow (dx0, dy0) in flow-space pixels
// BA = backward flow (dx1, dy1) in flow-space pixels
layout (binding = 2) uniform sampler2D flow_tex;

// Occlusion visibility mask (single channel R, 0.0 .. 1.0)
layout (binding = 3) uniform sampler2D mask_tex;

// Final output native resolution interpolated frame
layout (binding = 4, rgba8) uniform writeonly image2D out_frame;

layout (push_constant) uniform PushConstants {
    vec2 flow_size; // Dimensions of the flow map (e.g. 640.0, 360.0)
} pc;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_frame);

    if (pos.x >= size.x || pos.y >= size.y) {
        return;
    }

    // Normalized UV coordinate for the center of the current pixel (0.0 .. 1.0)
    vec2 uv = (vec2(pos) + 0.5) / vec2(size);

    // Bilinear sample from flow and mask
    vec4 flow = texture(flow_tex, uv);
    float mask = texture(mask_tex, uv).r;

    // Convert pixel displacement in flow space to normalized UV space
    vec2 offset0 = flow.xy / pc.flow_size;
    vec2 offset1 = flow.zw / pc.flow_size;

    // Hardware-accelerated bilinear sampling from original uncompressed textures
    vec4 c0 = texture(img0, uv + offset0);
    vec4 c1 = texture(img1, uv + offset1);

    // Blend according to neural occlusion mask
    vec4 result = mix(c1, c0, mask);

    imageStore(out_frame, pos, result);
}
